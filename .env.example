# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server mode OIDC authentication. Use the issuer URL exactly as published by
# the provider (the server reads /.well-known/openid-configuration from it).
AUTH_REQUIRED=false
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# Initial master account must already exist in the OIDC provider.
AUTH_MASTER_EMAIL=""
AUTH_MASTER_PASSWORD=""
# For HTTPS deployments set COOKIE_SECURE=true. Cross-origin web clients must
# list their exact origins, comma separated; leave empty for same-origin use.
COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=""

# Yjs-compatible WebSocket endpoint for collaborative document editing.
# Requires a separately hosted y-websocket/Hocuspocus service with persistence
# and authentication configured before enabling this in a shared deployment.
VITE_YJS_WS_URL=""
