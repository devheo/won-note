{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "item:transfer": "tsx scripts/item-transfer.ts",
    "test:exchange": "node --import tsx --test tests/item-exchange.test.ts",
    "test:exchange-ui": "playwright test tests/item-exchange.spec.ts --workers=1",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:pptx": "playwright test tests/pptx-conversion.spec.ts --workers=1",
    "test:transfer": "playwright test tests/note-transfer.spec.ts tests/pptx-conversion.spec.ts tests/pdf-large.spec.ts --workers=1",
    "tauri": "tauri"
  },
