{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WON 노트 (WonNote)",
  "version": "0.1.0",
  "identifier": "com.wonnote.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://10.131.171.98:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WON 노트 (WonNote)",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
	"devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["Korean", "English"]
      }
    }
  }
}
